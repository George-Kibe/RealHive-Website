# ---------------------------------------------------------------------------
# RealHive Consultants - environment reference
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored - never commit real credentials.
# Every variable below is read server-side only (API routes / lib code).
# None are NEXT_PUBLIC_*, so none are exposed to the browser.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------
# MongoDB connection string, including the database name.
# Used by: src/db/connectDB.js
# Local:  mongodb://127.0.0.1:27017/realhive
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/realhive?retryWrites=true&w=majority
# Production: Atlas project "realhive-website", cluster "realhive-website" (M0, AWS us-east-1),
#   app user "realhive-app" (readWrite on the realhive database only).
MONGODB_URI=mongodb://127.0.0.1:27017/realhive


# --- Auth / JWT ------------------------------------------------------------
# Signing secrets for the two token types. Use two DIFFERENT long random
# strings - generate each with:  openssl rand -base64 48
# Used by: src/lib/generateTokens.js, src/app/api/auth/*
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string


# --- Outbound email (Amazon SES) ------------------------------------------
# Every email (dev and prod) is sent through Amazon SES v2 by src/lib/emails.js.
# The IAM key needs ses:SendRawEmail (ses:SendEmail on SESv2) in the region
# below. SES account eu-west-1 is out of the sandbox and realhiveconsultants.com
# is a verified identity with DKIM, so any address on the domain can send.
AWS_SES_ADMIN_ACCESS_KEY_ID=
AWS_SES_ADMIN_SECRET_KEY=
AWS_SES_REGION=eu-west-1

# Optional overrides (defaults shown). EMAIL_FROM must be on a verified identity.
# EMAIL_FROM=no-reply@realhiveconsultants.com
# EMAIL_REPLY_TO=info@realhiveconsultants.com   (also the .ics organiser and quotes fallback)


# Optional: where contact-form enquiries go (src/lib/emails.js).
# Defaults to georgekibew@gmail.com, the address the form has always used.
# ENQUIRIES_NOTIFY_EMAIL=hello@example.com
#
# Optional: where "new quote request" notifications go (src/lib/emails.js).
# Defaults to EMAIL_REPLY_TO (info@realhiveconsultants.com).
# QUOTES_NOTIFY_EMAIL=sales@example.com


# --- Canonical site origin (SEO) -------------------------------------------
# The single origin every canonical URL, sitemap entry and OG image resolves
# against. MUST be the production domain, with protocol and NO trailing slash.
#
# The site is reachable on two origins that serve identical content:
#   https://realhiveconsultants.com          <- canonical, use this
#   https://realhive-consultants.vercel.app  <- deploy origin
# Setting this to the .com is what stops the two competing as duplicates.
# Used by: src/lib/seo.js (metadataBase, canonicals, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://realhiveconsultants.com


# --- Cloudinary (blog images) ---------------------------------------------
# From the Cloudinary console (Dashboard -> API Keys -> "API environment
# variable"). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# The server SDK reads it directly. next.config.js derives the public
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME / _API_KEY from it at build time; the
# secret never reaches the browser. Must be set at BUILD time on Vercel.
# Used by: next.config.js, src/app/api/cloudinary/sign, scripts/seed-blog.mjs
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>


# --- Analytics and search verification (all optional) ---------------------
# Google Analytics 4 measurement ID (GA4 Admin -> Data streams -> Web).
# Public: inlined into the page at BUILD time, so redeploy after changing it.
# Unset = no GA and no cookie banner. Used by: src/lib/analytics.js
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Only needed when verifying with an HTML meta tag rather than DNS:
# Search Console "URL prefix" property -> the content="..." value of its meta tag.
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> the content="..." value of its msvalidate.01 meta tag.
# BING_SITE_VERIFICATION=


# --- Google Calendar + Meet for consultation bookings (optional) ----------
# With these set, every booking creates an event with a Google Meet link on
# the calendar below and invites the client. Without them, the team gets a
# pre-filled "Create in Google Calendar" link instead.
# CLIENT_ID / SECRET: Google Cloud -> APIs & Services -> Credentials ->
#   OAuth client ID of type "Desktop app" (Calendar API enabled).
# REFRESH_TOKEN: run `npm run google-auth` once, signed in as the calendar owner.
# CALENDAR_ID: optional, defaults to that account's primary calendar.
# Used by: src/lib/booking/google.js, scripts/google-auth.mjs
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
#
# Where booking notifications go (default georgekibew@gmail.com).
# BOOKINGS_NOTIFY_EMAIL=


# --- M-Pesa / Safaricom Daraja (STK push) ----------------------------------
# NOTE: src/app/api/mpesa/stkpush/route.js calls the PRODUCTION endpoints
# (api.safaricom.co.ke), not the sandbox - use live Daraja credentials, or
# point the route at sandbox.safaricom.co.ke while testing.
#
# MPESA_CONSUMER_KEY / MPESA_SECRET_KEY - your Daraja app credentials, used to
#   fetch the OAuth access token.
# MPESA_PAYBILL - the business short code (also sent as PartyB).
# MPESA_PASSKEY - the Lipa Na M-Pesa Online passkey, hashed together with the
#   short code and timestamp to build the request password.
MPESA_CONSUMER_KEY=
MPESA_SECRET_KEY=
MPESA_PAYBILL=
MPESA_PASSKEY=
