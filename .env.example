# ---------------------------------------------------------------------------
# RealHive Consultants - environment reference
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored - never commit real credentials.
# Every variable below is read server-side only (API routes / lib code).
# None are NEXT_PUBLIC_*, so none are exposed to the browser.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------
# MongoDB connection string, including the database name.
# Used by: src/db/connectDB.js
# Local:  mongodb://127.0.0.1:27017/realhive
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/realhive?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/realhive


# --- Auth / JWT ------------------------------------------------------------
# Signing secrets for the two token types. Use two DIFFERENT long random
# strings - generate each with:  openssl rand -base64 48
# Used by: src/lib/generateTokens.js, src/app/api/auth/*, src/app/api/properties
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string


# --- Outbound email (SMTP) -------------------------------------------------
# The transport is hardcoded to smtp.gmail.com:465 (TLS) in
# src/lib/emails.js and src/app/api/alert/route.js, so these must be
# Gmail credentials.
#
# SENDER_EMAIL   - the Gmail address; used as both the SMTP username and the
#                  "From" address on outgoing mail.
# EMAIL_PASSWORD - a Gmail *App Password* (16 chars, requires 2FA enabled),
#                  NOT the normal account password.
#                  https://myaccount.google.com/apppasswords
SENDER_EMAIL=your-address@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx


# --- Canonical site origin (SEO) -------------------------------------------
# The single origin every canonical URL, sitemap entry and OG image resolves
# against. MUST be the production domain, with protocol and NO trailing slash.
#
# The site is reachable on two origins that serve identical content:
#   https://realhiveconsultants.com          <- canonical, use this
#   https://realhive-consultants.vercel.app  <- deploy origin
# Setting this to the .com is what stops the two competing as duplicates.
# Used by: src/lib/seo.js (metadataBase, canonicals, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://realhiveconsultants.com


# --- Public site URL -------------------------------------------------------
# Base URL used to build the password-reset link emailed to users
# (`${CLIENT_URL}/reset-password?token=...`). No trailing slash.
# Used by: src/lib/emails.js
# Dev:  http://localhost:3000
# Prod: https://realhiveconsultants.com
CLIENT_URL=http://localhost:3000


# --- M-Pesa / Safaricom Daraja (STK push) ----------------------------------
# NOTE: src/app/api/mpesa/stkpush/route.js calls the PRODUCTION endpoints
# (api.safaricom.co.ke), not the sandbox - use live Daraja credentials, or
# point the route at sandbox.safaricom.co.ke while testing.
#
# MPESA_CONSUMER_KEY / MPESA_SECRET_KEY - your Daraja app credentials, used to
#   fetch the OAuth access token.
# MPESA_PAYBILL - the business short code (also sent as PartyB).
# MPESA_PASSKEY - the Lipa Na M-Pesa Online passkey, hashed together with the
#   short code and timestamp to build the request password.
MPESA_CONSUMER_KEY=
MPESA_SECRET_KEY=
MPESA_PAYBILL=
MPESA_PASSKEY=
